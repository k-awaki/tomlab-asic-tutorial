# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_library_set -name TimingLibSet -timing {/opt/cadence/nangate45/NangateOpenCellLibrary_PDKv1_3_v2010_12/Front_End/Liberty/ECSM/NangateOpenCellLibrary_slow_ecsm.lib}
create_constraint_mode -name ConstMode -sdc_files {genus/outputs_power/counter_m.sdc}
create_rc_corner -name RcCorner -cap_table /opt/cadence/nangate45/captables/NCSU_FreePDK_45nm.capTbl
create_delay_corner -name DelayCorner -library_set {TimingLibSet} -rc_corner {RcCorner}
create_analysis_view -name AnalysisView -constraint_mode {ConstMode} -delay_corner {DelayCorner}
set_analysis_view -setup {AnalysisView} -hold {AnalysisView}


